# Copy to .env and fill in one provider.

# --- LLM (SQL generation and mock /execute results) ---
# openai or gemini. Leave unset to pick from whichever key is present.
LLM_PROVIDER=gemini
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides. Defaults: gpt-4o-mini (openai), gemini-3.5-flash (gemini).
# LLM_MODEL=
# LLM_BASE_URL=   # any OpenAI-compatible endpoint; OPENAI_BASE_URL also works

# --- Infrastructure ---
DATABASE_URL=postgresql://malay2sql-user:password@localhost:5432/malay2sql
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MODEL_PATH=models/translator
RERANKER_PATH=models/reranker
